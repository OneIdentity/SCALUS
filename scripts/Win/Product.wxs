<?xml version="1.0" encoding="utf-8"?>
<!--
  SCALUS Windows installer (WiX v4+ schema, built with the `wix` dotnet tool).

  Replaces the legacy WiX 3 authoring. The whole published payload is harvested
  automatically with the <Files> element so the Photino UI (ui\scalus-ui.exe plus
  its native webview .dll, wwwroot and ~200 runtime files) ships without listing
  every file by hand. The old local-web-server UI (web.config, Ui\Web\*) is gone.

  Required build variables (passed with `-d name=value`):
    sourcedir - the published payload (Publish\<config>\<rid>)
    tmpdir    - staging dir holding icon.ico, banner.bmp, dialog.bmp, license.rtf
    Version   - product version (e.g. 1.1.0.123)
  Required extensions: WixToolset.UI.wixext
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="SCALUS"
           Manufacturer="One Identity"
           Version="$(var.Version)"
           UpgradeCode="71bf8eb3-8498-438a-b1c4-e5165e0ed7a4"
           Scope="perMachine"
           Compressed="yes">

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. If you are sure you want to downgrade, remove the existing installation via Programs and Features." />

    <!-- Add/Remove Programs icon. -->
    <Icon Id="icon.ico" SourceFile="$(var.tmpdir)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />

    <!-- WixUI_Minimal chrome. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.tmpdir)\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.tmpdir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.tmpdir)\dialog.bmp" />
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Deregister protocol handlers on uninstall (not on upgrade). -->
    <CustomAction Id="UninstallScalusUser" Return="check" Impersonate="yes" Execute="deferred"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]scalus.exe&quot; unregister --remove-configuration" />
    <CustomAction Id="UninstallScalusMachine" Return="check" Impersonate="no" Execute="deferred"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]scalus.exe&quot; unregister --root" />
    <InstallExecuteSequence>
      <Custom Action="UninstallScalusMachine" After="InstallInitialize"
              Condition="(NOT UPGRADINGPRODUCTCODE) AND (REMOVE=&quot;ALL&quot;)" />
      <Custom Action="UninstallScalusUser" After="UninstallScalusMachine"
              Condition="(NOT UPGRADINGPRODUCTCODE) AND (REMOVE=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <Feature Id="DefaultFeature" Title="SCALUS" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>
  </Package>

  <!-- Install location: %ProgramFiles%\SCALUS (native bitness). -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="SCALUS" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuSubfolder" Name="SCALUS" />
    </StandardDirectory>
  </Fragment>

  <!-- Harvest the entire published payload (scalus.exe, ui\**, examples\**, readme.txt). -->
  <Fragment>
    <ComponentGroup Id="PayloadFiles" Directory="INSTALLDIR">
      <Files Include="$(var.sourcedir)\**" />
    </ComponentGroup>
  </Fragment>

  <!-- Start Menu shortcuts: the GUI and the readme. -->
  <Fragment>
    <ComponentGroup Id="ApplicationShortcuts" Directory="ProgramMenuSubfolder">
      <Component Id="ApplicationShortcuts" Guid="43811f49-72ad-47ff-984f-6b11d9c9f5c9">
        <Shortcut Id="ApplicationShortcut1" Name="SCALUS" Description="SCALUS Configuration"
                  Target="[INSTALLDIR]ui\scalus-ui.exe" WorkingDirectory="INSTALLDIR" Icon="icon.ico" />
        <Shortcut Id="ApplicationShortcut2" Name="Readme" Description="SCALUS ReadMe"
                  Target="[INSTALLDIR]examples\readme.txt" WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\OneIdentity\SCALUS" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="ProgramMenuSubfolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
